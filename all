Yes — let's make it as beginner-friendly as possible, with the explanation written directly beside the code. I'll also keep the 3 pivot implementations separate, so you can understand each one individually.

1. First element as pivot

#include <iostream>
using namespace std;

int comparisons = 0;
int swaps = 0;
int calls = 0;

int partitionFirst(int a[], int low, int high)
{
    int pivot = a[low]; // First element is pivot
    int i = low + 1; // Start from next element
    int j = high; // Start from last element

    while (i <= j)
    {
        while (i <= high && a[i] <= pivot)
        {
            comparisons++; // Comparison
            i++;
        }

        while (j >= low && a[j] > pivot)
        {
            comparisons++; // Comparison
            j--;
        }

        if (i < j)
        {
            swap(a[i], a[j]); // Swap elements
            swaps++;
        }
    }

    swap(a[low], a[j]); // Put pivot in correct place
    swaps++;

    return j; // Return pivot position
}

void quickSortFirst(int a[], int low, int high)
{
    calls++; // Count recursive call

    if (low < high)
    {
        int p = partitionFirst(a, low, high);

        quickSortFirst(a, low, p - 1); // Left side
        quickSortFirst(a, p + 1, high); // Right side
    }
}


