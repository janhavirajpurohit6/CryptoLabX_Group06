2. Last element as pivot

int partitionLast(int a[], int low, int high)
{
    int pivot = a[high]; // Last element is pivot
    int i = low - 1; // Position for smaller element

    for (int j = low; j < high; j++)
    {
        comparisons++; // Count comparison

        if (a[j] < pivot)
        {
            i++;

            swap(a[i], a[j]); // Put smaller element left
            swaps++;
        }
    }

    swap(a[i + 1], a[high]); // Put pivot in correct place
    swaps++;

    return i + 1; // Return pivot position
}

void quickSortLast(int a[], int low, int high)
{
    calls++; // Count recursive call

    if (low < high)
    {
        int p = partitionLast(a, low, high);

        quickSortLast(a, low, p - 1); // Sort left
        quickSortLast(a, p + 1, high); // Sort right
    }
}


