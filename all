3. Middle element as pivot

int partitionMiddle(int a[], int low, int high)
{
    int mid = (low + high) / 2; // Find middle

    int pivot = a[mid]; // Middle element is pivot

    swap(a[mid], a[high]); // Move pivot to end
    swaps++;

    int i = low - 1;

    for (int j = low; j < high; j++)
    {
        comparisons++; // Count comparison

        if (a[j] < pivot)
        {
            i++;

            swap(a[i], a[j]); // Swap
            swaps++;
        }
    }

    swap(a[i + 1], a[high]); // Put pivot correctly
    swaps++;

    return i + 1;
}

void quickSortMiddle(int a[], int low, int high)
{
    calls++; // Count recursive call

    if (low < high)
    {
        int p = partitionMiddle(a, low, high);

        quickSortMiddle(a, low, p - 1); // Sort left
        quickSortMiddle(a, p + 1, high);// Sort right
    }
}

Simple main() to test them

int main()
{
    int a[1000];
    int n = 100;

    // Make a simple array
    for (int i = 0; i < n; i++)
        a[i] = rand() % 1000;


    // -------- FIRST PIVOT --------

    comparisons = 0;
    swaps = 0;
    calls = 0;

    quickSortFirst(a, 0, n - 1);

    cout << "FIRST PIVOT\n";
    cout << "Comparisons = " << comparisons << endl;
    cout << "Swaps = " << swaps << endl;
    cout << "Calls = " << calls << endl;


    // -------- LAST PIVOT --------

    comparisons = 0;
    swaps = 0;
    calls = 0;

    quickSortLast(a, 0, n - 1);

    cout << "\nLAST PIVOT\n";
    cout << "Comparisons = " << comparisons << endl;
    cout << "Swaps = " << swaps << endl;
    cout << "Calls = " << calls << endl;


    // -------- MIDDLE PIVOT --------

    comparisons = 0;
    swaps = 0;
    calls = 0;

    quickSortMiddle(a, 0, n - 1);

    cout << "\nMIDDLE PIVOT\n";
    cout << "Comparisons = " << comparisons << endl;
    cout << "Swaps = " << swaps << endl;
    cout << "Calls = " << calls << endl;

    return 0;
}

